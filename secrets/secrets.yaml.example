# Exemplo de secrets/secrets.yaml do sops-nix.
# Este arquivo NÃO é usado pelo sistema — apenas documenta o formato.
#
# Como criar o arquivo real:
#   1. Configure as chaves em .sops.yaml (veja as instruções lá).
#   2. cp secrets/secrets.yaml.example secrets/secrets.yaml
#   3. sops encrypt --in-place secrets/secrets.yaml
#   4. Edite com: sops secrets/secrets.yaml
#   5. COMMIT o arquivo encriptado (é seguro e intencional).
#
# Cada segredo vira um arquivo em /run/secrets/<caminho> (NixOS)
# ou ~/.config/sops-nix/<caminho> (home-manager standalone).
#
# Exemplos de conteúdo:
#
# git:
#   token: "ghp_..."
# vpn:
#   password: "..."
#
# Referência no código:
#   sops.secrets."git/token" = { };
#   # e use config.sops.secrets."git/token".path
